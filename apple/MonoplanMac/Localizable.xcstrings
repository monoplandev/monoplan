        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac"
          }
        }
      }
    },
    "This removes the local copy of your data from this Mac and starts a fresh local workspace. Your data stays on the server and comes back when you sign in again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la copia local de tus datos de este Mac y crea un espacio de trabajo local nuevo. Tus datos permanecen en el servidor y vuelven cuando inicias sesión de nuevo."
          }
        }
      }
    },
