      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acciones del espacio de trabajo"
          }
        }
      }
    },
    "Workspaces" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espacios"
          }
        }
      }
    },
    "Write these 12 words down and keep them somewhere safe. They are shown only once and are the only way to reset a forgotten password." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota estas 12 palabras y guárdalas en un lugar seguro. Solo se muestran una vez y son la única forma de restablecer una contraseña olvidada."
          }
        }
      }
    },
    "You" : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú"
          }
        }
      }
    },
    "You leave every workspace shared with you." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sales de todos los espacios compartidos contigo."
          }
        }
      }
    },
    "You will get a 12-word recovery code. It is the only way back in if you forget your password: Monoplan cannot reset it for you." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibirás un código de recuperación de 12 palabras. Es la única forma de volver a entrar si olvidas tu contraseña: Monoplan no puede restablecerla por ti."
          }
        }
      }
    },
    "You’re all set" : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo listo"
          }
        }
      }
    },
    "Your Personal workspace and every workspace you own are erased from the server for everyone, including anyone they are shared with." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu espacio Personal y todos los espacios que te pertenecen se borran del servidor para todos, incluidas las personas con quienes los compartes."
          }
        }
      }
    },
    "Your recovery code" : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu código de recuperación"
          }
        }
      }
    },
