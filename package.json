{
  "name": "monoplan",
  "private": true,
  "workspaces": [
    "js/*"
  ],
  "scripts": {
    "config": "bun js/config/gen-config.ts",
    "config:deploy": "bun js/config/gen-config.ts deploy",
    "ci:alpha": "gh workflow run deploy.yml",
    "server": "cargo run -p monoplan-server --",
    "cli": "MONOPLAN_DATA_DIR=local/cli cargo run -p monoplan --",
    "cli:prod": "MONOPLAN_DATA_DIR=local/cli cargo run --release -p monoplan --",
    "build": "cargo build",
    "vendor:emoji": "bun js/web/scripts/vendor-emoji.ts",
    "build:wasm": "wasm-pack build core/web --target nodejs --out-dir ../../js/core/wasm --out-name monoplan_core_web",
    "build:wasm:web": "wasm-pack build core/web --target bundler --out-dir ../../js/core/wasm-web --out-name monoplan_core_web",
    "build:apple": "apple/build-xcframework.sh",
    "start": "process-compose -f local/process-compose.yaml",
    "wipe": "scripts/wipe.sh",
    "test": "cargo test",
    "test:server": "cargo test -p monoplan-server",
    "test:core:js": "bun test --cwd js/core",
    "perf": "cargo run --release -p monoplan-core --example perf --",
    "fmt": "cargo fmt --all",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "typecheck": "tsc --noEmit -p js/config && tsc --noEmit -p js/core && tsc --noEmit -p js/web",
    "vendor:tz": "bun js/web/scripts/vendor-tz.ts"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
